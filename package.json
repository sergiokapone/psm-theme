{
  "name": "psm-theme",
  "displayName": "PSM Theme",
  "description": "PSM Theme",
  "version": "1.0.20",
  "publisher": "Sergiy",
  "author": {
    "name": "psm"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#19232D",
    "theme": "dark"
  },
  "homepage": "https://github.com/sergiokapone/psm-theme",
  "bugs": {
    "url": "https://github.com/sergiokapone/psm-theme"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sergiokapone/psm-theme"
  },
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "PSM Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/PSM Theme-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "tikz.injection",
        "path": "./syntaxes/tikz.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      }
    ]
  },
  "devDependencies": {
    "vsce": "^2.15.0"
  }
}
