{
  "name": "psm-theme",
  "displayName": "PSM Theme",
  "description": "Dark theme for Python, Data Science and LaTeX/TikZ, based on Spyder IDE colors",
  "version": "1.2.1",
  "publisher": "Sergiy",
  "author": {
    "name": "psm"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#19232D",
    "theme": "dark"
  },
  "homepage": "https://github.com/sergiokapone/psm-theme",
  "bugs": {
    "url": "https://github.com/sergiokapone/psm-theme"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sergiokapone/psm-theme"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "python",
    "spyder",
    "latex",
    "tikz"
  ],
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "contributes": {
    "themes": [
      {
        "label": "PSM Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/PSM Theme-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "tikz.injection",
        "path": "./syntaxes/tikz.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      },
      {
        "scopeName": "tikz-wrap.injection",
        "path": "./syntaxes/tikz-wrap.injection.json",
        "injectTo": [
          "text.tex.latex"
        ]
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
